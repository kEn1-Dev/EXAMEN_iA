@model MonitorSerial.Models.Lectura
@{
    ViewBag.Title = "Detalles de Lectura";
}

<div class="row">
    <div class="col s12 m8 offset-m2">
        <div class="card white z-depth-1">
            <div class="card-content">
                <span class="card-title teal-text text-darken-3">Detalles de la Lectura #@Model.LecturaId</span>
                <ul class="collection">
                    <li class="collection-item">
                        <strong>Dispositivo:</strong> @(Model.Dispositivo != null ? Model.Dispositivo.Nombre : "-")
                    </li>
                    <li class="collection-item">
                        <strong>Puerto COM:</strong> @(Model.Dispositivo != null ? Model.Dispositivo.PuertoCOM : "-")
                    </li>
                    <li class="collection-item">
                        <strong>Temperatura:</strong> @Model.Temperatura.ToString("0.00") °C
                    </li>
                    <li class="collection-item">
                        <strong>Fecha y hora:</strong> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")
                    </li>
                </ul>
            </div>
            <div class="card-action">
                @if (User.IsInRole("Administrador"))
                {
                    <a href="@Url.Action("Edit", new { id = Model.LecturaId })" class="btn amber darken-3 waves-effect waves-light">Editar</a>
                }
                <a href="@Url.Action("Index")" class="btn-flat teal-text text-darken-3">Volver al historial</a>
            </div>
        </div>
    </div>
</div>
