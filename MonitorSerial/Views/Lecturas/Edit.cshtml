@model MonitorSerial.Models.Lectura
@{
    ViewBag.Title = "Editar Lectura";
}

<div class="row">
    <div class="col s12 m8 offset-m2">
        <div class="card white z-depth-1">
            <div class="card-content">
                <span class="card-title teal-text text-darken-3">Editar Lectura #@Model.LecturaId (Solo Administrador)</span>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "red-text text-darken-3" })
                    @Html.HiddenFor(model => model.LecturaId)

                    <div class="section">
                        @Html.LabelFor(model => model.DispositivoId, "Dispositivo", htmlAttributes: new { @class = "black-text" })
                        @Html.DropDownList("DispositivoId", null, htmlAttributes: new { @class = "browser-default" })
                        @Html.ValidationMessageFor(model => model.DispositivoId, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="input-field section">
                        @Html.EditorFor(model => model.Temperatura, new { htmlAttributes = new { @class = "validate", step = "0.01" } })
                        @Html.LabelFor(model => model.Temperatura, new { @class = "active" })
                        @Html.ValidationMessageFor(model => model.Temperatura, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="input-field section">
                        @Html.EditorFor(model => model.FechaHora, new { htmlAttributes = new { @class = "validate" } })
                        @Html.LabelFor(model => model.FechaHora, new { @class = "active" })
                        @Html.ValidationMessageFor(model => model.FechaHora, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="section">
                        <button type="submit" class="btn waves-effect waves-light amber darken-3">Guardar Cambios</button>
                        <a href="@Url.Action("Index")" class="btn-flat">Volver al historial</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
