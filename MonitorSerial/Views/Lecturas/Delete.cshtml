@model MonitorSerial.Models.Lectura
@{
    ViewBag.Title = "Eliminar Lectura";
}

<div class="row">
    <div class="col s12 m8 offset-m2">
        <div class="card white z-depth-1">
            <div class="card-content">
                <span class="card-title red-text text-darken-3">Confirmar Eliminación de Lectura #@Model.LecturaId</span>
                <p>¿Está seguro de que desea eliminar este registro de lectura? Esta acción requiere el rol <strong>Administrador</strong>.</p>

                <ul class="collection" style="margin-top: 16px;">
                    <li class="collection-item">
                        <strong>Dispositivo:</strong> @(Model.Dispositivo != null ? Model.Dispositivo.Nombre : "-")
                    </li>
                    <li class="collection-item">
                        <strong>Temperatura:</strong> @Model.Temperatura.ToString("0.00") °C
                    </li>
                    <li class="collection-item">
                        <strong>Fecha y hora:</strong> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")
                    </li>
                </ul>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="section">
                        <button type="submit" class="btn waves-effect waves-light red darken-2">Confirmar Eliminación</button>
                        <a href="@Url.Action("Index")" class="btn-flat">Cancelar</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
