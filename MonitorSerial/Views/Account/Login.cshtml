@using MonitorSerial.Models
@model LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="row">
    <div class="col s12 m6 offset-m3">
        <div class="card white z-depth-2">
            <div class="card-content">
                <span class="card-title teal-text text-darken-3">Iniciar Sesión en MonitorSerial</span>
                <p class="grey-text text-darken-1">
                    Ingrese con una cuenta registrada para vigilar la temperatura de la sala de equipos.
                </p>

                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "red-text text-darken-3" })

                    <div class="input-field section">
                        @Html.TextBoxFor(m => m.Email, new { @class = "validate" })
                        @Html.LabelFor(m => m.Email, new { @class = "active" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="input-field section">
                        @Html.PasswordFor(m => m.Password, new { @class = "validate" })
                        @Html.LabelFor(m => m.Password, new { @class = "active" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>

                    <p>
                        <label>
                            <input type="checkbox" name="RememberMe" value="true" />
                            <span>Recordar mi sesión</span>
                        </label>
                    </p>

                    <div class="section" style="margin-top: 20px;">
                        <button type="submit" class="btn waves-effect waves-light teal darken-2">Iniciar sesión</button>
                        <a href="@Url.Action("Register", "Account")" class="btn-flat teal-text text-darken-3">Registrar nuevo usuario</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
